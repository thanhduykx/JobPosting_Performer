    <ui:InvokeCode ContinueOnError="{x:Null}" Code="Dim requestedIds As New HashSet(Of String)(StringComparer.OrdinalIgnoreCase)&#xA;If Not String.IsNullOrWhiteSpace(in_JobIds) Then&#xA;    For Each idPart In in_JobIds.Split({&quot;,&quot;c, &quot;;&quot;c, &quot;|&quot;c}, StringSplitOptions.RemoveEmptyEntries)&#xA;        Dim cleaned = idPart.Trim()&#xA;        If Not String.IsNullOrWhiteSpace(cleaned) Then requestedIds.Add(cleaned)&#xA;    Next&#xA;End If&#xA;&#xA;Dim hasFilter As Boolean = requestedIds.Count &gt; 0&#xA;Dim selectedIds As New List(Of String)()&#xA;Dim rowsBuilder As New System.Text.StringBuilder()&#xA;&#xA;Dim rolesList As New List(Of String)()&#xA;Dim levelsList As New List(Of String)()&#xA;Dim locationsList As New List(Of String)()&#xA;Dim setupsList As New List(Of String)()&#xA;Dim schedulesList As New List(Of String)()&#xA;Dim qualsList As New List(Of String)()&#xA;&#xA;For Each row As DataRow In in_Jobs.Rows&#xA;    Dim jobId As String = If(row.Table.Columns.Contains(&quot;JobID&quot;), row(&quot;JobID&quot;).ToString().Trim(), If(row.Table.Columns.Contains(&quot;Role&quot;), row(&quot;Role&quot;).ToString().Trim(), String.Empty))&#xA;    If String.IsNullOrWhiteSpace(jobId) AndAlso row.Table.Columns.Contains(&quot;Role&quot;) Then jobId = row(&quot;Role&quot;).ToString().Trim()&#xA;    If hasFilter AndAlso Not requestedIds.Contains(jobId) Then Continue For&#xA;&#xA;    Dim roleVal As String = If(row.Table.Columns.Contains(&quot;Title&quot;), row(&quot;Title&quot;).ToString().Trim(), If(row.Table.Columns.Contains(&quot;Role&quot;), row(&quot;Role&quot;).ToString().Trim(), String.Empty))&#xA;    Dim levelVal As String = If(row.Table.Columns.Contains(&quot;CareerLevel&quot;), row(&quot;CareerLevel&quot;).ToString().Trim(), If(row.Table.Columns.Contains(&quot;Career Level &quot;), row(&quot;Career Level &quot;).ToString().Trim(), String.Empty))&#xA;    Dim locationVal As String = If(row.Table.Columns.Contains(&quot;WorkLocation&quot;), row(&quot;WorkLocation&quot;).ToString().Trim(), If(row.Table.Columns.Contains(&quot;Work Location&quot;), row(&quot;Work Location&quot;).ToString().Trim(), String.Empty))&#xA;    Dim setupVal As String = If(row.Table.Columns.Contains(&quot;WorkSetup&quot;), row(&quot;WorkSetup&quot;).ToString().Trim(), If(row.Table.Columns.Contains(&quot;Work Setup&quot;), row(&quot;Work Setup&quot;).ToString().Trim(), String.Empty))&#xA;    Dim scheduleVal As String = If(row.Table.Columns.Contains(&quot;WorkSchedule&quot;), row(&quot;WorkSchedule&quot;).ToString().Trim(), If(row.Table.Columns.Contains(&quot;Work Schedule&quot;), row(&quot;Work Schedule&quot;).ToString().Trim(), String.Empty))&#xA;&#xA;    selectedIds.Add(jobId)&#xA;    If Not String.IsNullOrWhiteSpace(roleVal) AndAlso Not rolesList.Contains(roleVal) Then rolesList.Add(roleVal)&#xA;    If Not String.IsNullOrWhiteSpace(levelVal) AndAlso Not levelsList.Contains(levelVal) Then levelsList.Add(levelVal)&#xA;    If Not String.IsNullOrWhiteSpace(locationVal) AndAlso Not locationsList.Contains(locationVal) Then locationsList.Add(locationVal)&#xA;    If Not String.IsNullOrWhiteSpace(setupVal) AndAlso Not setupsList.Contains(setupVal) Then setupsList.Add(setupVal)&#xA;    If Not String.IsNullOrWhiteSpace(scheduleVal) AndAlso Not schedulesList.Contains(scheduleVal) Then schedulesList.Add(scheduleVal)&#xA;Next&#xA;&#xA;If Not String.IsNullOrWhiteSpace(in_Qualifications) Then&#xA;    For Each q In in_Qualifications.Split({&quot;;&quot;c, vbCrLf, vbLf}, StringSplitOptions.RemoveEmptyEntries)&#xA;        Dim cleaned = q.Trim()&#xA;        If Not String.IsNullOrWhiteSpace(cleaned) AndAlso Not qualsList.Contains(cleaned) Then qualsList.Add(cleaned)&#xA;    Next&#xA;End If&#xA;&#xA;Dim templatePath As String = Path.Combine(Environment.CurrentDirectory, &quot;Templates&quot;, in_TemplateName)&#xA;Dim templateContent As String = File.ReadAllText(templatePath)&#xA;&#xA;out_EmailBody = templateContent.Replace(&quot;{{Role}}&quot;, String.Join(&quot;, &quot;, rolesList)).Replace(&quot;{{CareerLevel}}&quot;, String.Join(&quot;, &quot;, levelsList)).Replace(&quot;{{WorkLocation}}&quot;, String.Join(&quot;, &quot;, locationsList)).Replace(&quot;{{WorkSetup}}&quot;, String.Join(&quot;, &quot;, setupsList)).Replace(&quot;{{WorkSchedule}}&quot;, String.Join(&quot;, &quot;, schedulesList))" DisplayName="Build Email Body" sap:VirtualizedContainerService.HintSize="568,196.8" sap2010:WorkflowViewState.IdRef="InvokeCode_BuildBody">
