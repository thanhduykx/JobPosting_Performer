    <ui:InvokeCode Code="Dim startInfo As New System.Diagnostics.ProcessStartInfo()&#xA;Dim pdfPath As String = out_PdfPath&#xA;Dim htmlPath As String = Path.Combine(Path.GetTempPath(), &quot;recruit_temp_email.html&quot;)&#xA;&#xA;' Try standard locations for Edge&#xA;Dim edgePath As String = &quot;C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe&quot;&#xA;If Not File.Exists(edgePath) Then edgePath = &quot;C:\Program Files\Microsoft\Edge\Application\msedge.exe&quot;&#xA;If Not File.Exists(edgePath) Then edgePath = &quot;msedge.exe&quot; ' Fallback to PATH&#xA;&#xA;startInfo.FileName = edgePath&#xA;startInfo.Arguments = &quot;--headless --disable-gpu --no-sandbox --allow-file-access-from-files --print-to-pdf-no-header --print-to-pdf=&quot;&quot;&quot; + pdfPath + &quot;&quot;&quot; &quot;&quot;&quot; + htmlPath + &quot;&quot;&quot;&quot;&#xA;startInfo.WindowStyle = System.Diagnostics.ProcessWindowStyle.Hidden&#xA;startInfo.CreateNoWindow = True&#xA;&#xA;Try&#xA;    If File.Exists(pdfPath) Then File.Delete(pdfPath)&#xA;Catch ex As Exception&#xA;    Console.WriteLine(&quot;[PDF Error] Locked file: &quot; + ex.Message)&#xA;    Throw New Exception(&quot;Cannot clear old PDF file. Please close any open PDF viewers (like Edge/Chrome showing the Review page) and try again. Detail: &quot; + ex.Message)&#xA;End Try&#xA;&#xA;Dim p = System.Diagnostics.Process.Start(startInfo)&#xA;p.WaitForExit(30000)&#xA;&#xA;If Not p.HasExited Then&#xA;    Try&#xA;        p.Kill()&#xA;    Catch&#xA;    End Try&#xA;    Console.WriteLine(&quot;[PDF Error] Edge timeout after 30 seconds.&quot;)&#xA;    Throw New Exception(&quot;Edge timeout when generating PDF after 30 seconds. Please try again.&quot;)&#xA;End If&#xA;&#xA;If Not File.Exists(pdfPath) Then&#xA;    Console.WriteLine(&quot;[PDF Error] PDF was not generated by Edge.&quot;)&#xA;    Throw New Exception(&quot;Failed to generate PDF at: &quot; + pdfPath + &quot;. Edge might be missing or failed to run.&quot;)&#xA;End If" ContinueOnError="{x:Null}" DisplayName="Generate PDF with BR Omega" sap:VirtualizedContainerService.HintSize="568,196.8" sap2010:WorkflowViewState.IdRef="InvokeCode_GenPDF">
