        <ui:InvokeCode ContinueOnError="{x:Null}" DisplayName="Merge Bounce Data into JS" sap:VirtualizedContainerService.HintSize="1248,196.8" sap2010:WorkflowViewState.IdRef="InvokeCode_MergeJS">
      <ui:InvokeCode.Arguments>
        <InArgument x:TypeArguments="sd:DataTable" x:Key="dt_Report">[dt_Report]</InArgument>
      </ui:InvokeCode.Arguments>
      <ui:InvokeCode.Code><![CDATA[Dim q As String = Chr(34)
Dim jsPath As String = System.IO.Path.Combine(Environment.CurrentDirectory, "Data\UI\email_status_data.js")

Dim entries As New System.Collections.Generic.Dictionary(Of String, System.Collections.Generic.Dictionary(Of String, String))(StringComparer.OrdinalIgnoreCase)
Dim orderList As New System.Collections.Generic.List(Of String)()

If System.IO.File.Exists(jsPath) Then
    Dim content As String = System.IO.File.ReadAllText(jsPath)
    Dim entryRegex As New System.Text.RegularExpressions.Regex("\{([^}]+)\}")
    Dim fieldRegex As New System.Text.RegularExpressions.Regex(q & "(\w+)" & q & "\s*:\s*" & q & "([^" & q & "]*)" & q)
    For Each m As System.Text.RegularExpressions.Match In entryRegex.Matches(content)
        Dim body As String = m.Groups(1).Value
        Dim d As New System.Collections.Generic.Dictionary(Of String, String)
        For Each fm As System.Text.RegularExpressions.Match In fieldRegex.Matches(body)
            d(fm.Groups(1).Value) = fm.Groups(2).Value
        Next
        If d.ContainsKey("email") AndAlso Not String.IsNullOrEmpty(d("email")) Then
            If Not entries.ContainsKey(d("email")) Then orderList.Add(d("email"))
            entries(d("email")) = d
        End If
    Next
End If

For Each row As System.Data.DataRow In dt_Report.Rows
    Dim email As String = row("RecipientEmail").ToString()
    If String.IsNullOrEmpty(email) OrElse email = "Unknown" Then Continue For
    Dim target As System.Collections.Generic.Dictionary(Of String, String) = Nothing
    If entries.ContainsKey(email) Then
        target = entries(email)
    Else
        target = New System.Collections.Generic.Dictionary(Of String, String)
        target("email") = email
        target("time") = row("ReceivedDate").ToString()
        entries(email) = target
        orderList.Add(email)
    End If
    target("status") = "failed"
    target("errorCode") = row("ErrorCode").ToString()
    target("errorType") = row("ErrorType").ToString()
    target("reason") = row("Reason").ToString()
    target("action") = row("Action").ToString()
Next

Dim sb As New System.Text.StringBuilder()
sb.AppendLine("var emailStatusData = [")
Dim fields() As String = {"email", "status", "errorCode", "errorType", "reason", "action", "time"}
For i As Integer = 0 To orderList.Count - 1
    Dim d = entries(orderList(i))
    sb.Append("  {")
    For j As Integer = 0 To fields.Length - 1
        Dim k As String = fields(j)
        Dim v As String = If(d.ContainsKey(k), d(k), "")
        v = v.Replace("\", "\\").Replace(q, "\" & q)
        sb.Append(q & k & q & ": " & q & v & q)
        If j < fields.Length - 1 Then sb.Append(", ")
    Next
    sb.Append("}")
    If i < orderList.Count - 1 Then sb.Append(",")
    sb.AppendLine()
Next
sb.AppendLine("];")
System.IO.File.WriteAllText(jsPath, sb.ToString())
]]></ui:InvokeCode.Code>
    </ui:InvokeCode>
