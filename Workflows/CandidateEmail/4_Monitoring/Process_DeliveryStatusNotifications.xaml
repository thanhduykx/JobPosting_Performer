                    </ui:InvokeCode.Arguments>
                    <ui:InvokeCode.Code><![CDATA[' Parse SMTP error code (550, 421, 552, 554, 450...)
Dim codeMatch = System.Text.RegularExpressions.Regex.Match(in_Body, "\b([45]\d{2})\s+[\d.]+")
If codeMatch.Success Then
    out_Code = codeMatch.Groups(1).Value
Else
    out_Code = ""
End If

' Extract full error reason
Dim reasonMatch = System.Text.RegularExpressions.Regex.Match(in_Body, "([45]\d{2}\s+[\d.]+\s+.+?)(?:\r|\n|$)")
If reasonMatch.Success Then
    out_FullReason = reasonMatch.Value.Trim()
End If

' Classify error and recommend action
Dim bodyLower As String = in_Body.ToLower()

Select Case out_Code
    Case "550"
        If bodyLower.Contains("user") OrElse bodyLower.Contains("mailbox") OrElse bodyLower.Contains("does not exist") Then
            out_Type = "Permanent - Mailbox Not Found"
            out_Action = "Xóa khỏi danh sách"
        ElseIf bodyLower.Contains("domain") Then
            out_Type = "Permanent - Domain Invalid"
            out_Action = "Kiểm tra lại tên miền"
        ElseIf bodyLower.Contains("spam") OrElse bodyLower.Contains("blocked") Then
            out_Type = "Permanent - Spam Filter"
            out_Action = "Kiểm tra nội dung mail"
        Else
            out_Type = "Permanent - General Rejection"
            out_Action = "Không gửi lại"
        End If
        
    Case "552"
        out_Type = "Temporary - Mailbox Full"
        out_Action = "Thử lại sau 24 giờ"
        
    Case "421"
        out_Type = "Temporary - Server Busy"
        out_Action = "Thử lại sau vài giờ"
        
    Case "450"
        out_Type = "Temporary - Mailbox Unavailable"
        out_Action = "Thử lại sau"
        
    Case "554"
        out_Type = "Permanent - Policy Rejection"
        out_Action = "Kiểm tra nội dung & sender reputation"
        
    Case Else
        If Not String.IsNullOrEmpty(out_Code) Then
            If out_Code.StartsWith("5") Then
                out_Type = "Permanent - Other"
                out_Action = "Không gửi lại"
            ElseIf out_Code.StartsWith("4") Then
                out_Type = "Temporary - Other"
                out_Action = "Thử lại sau"
            End If
        Else
            out_Type = "Unknown"
            out_Action = "Cần review thủ công"
        End If
End Select
]]></ui:InvokeCode.Code>
