      <AssemblyReference>UiPath.Excel.Activities</AssemblyReference>
      <AssemblyReference>UiPath.System.Activities</AssemblyReference>
      <AssemblyReference>UiPath.UiAutomation.Activities</AssemblyReference>
    </scg:List>
  </TextExpression.ReferencesForImplementation>
  <Sequence DisplayName="Final_Review_And_Confirm" sap:VirtualizedContainerService.HintSize="800,2200" sap2010:WorkflowViewState.IdRef="Sequence_1">
    <Sequence.Variables>
      <Variable x:TypeArguments="x:String" Name="str_CandidatesParam" />
      <Variable x:TypeArguments="x:String" Name="str_FoundFile" />
    </Sequence.Variables>
    <sap:WorkflowViewStateService.ViewState>
      <scg:Dictionary x:TypeArguments="x:String, x:Object">
        <x:Boolean x:Key="IsExpanded">True</x:Boolean>
      </scg:Dictionary>
    </sap:WorkflowViewStateService.ViewState>
    <ui:LogMessage DisplayName="Log Prep" sap:VirtualizedContainerService.HintSize="720,111.2" sap2010:WorkflowViewState.IdRef="LogMessage_1" Level="Info" Message="[&quot;Step 3: Preparing candidate list for review...&quot;]" />
    <If Condition="[in_Mode.Equals(&quot;Auto&quot;)]" DisplayName="Lọc danh sách người nhận" sap:VirtualizedContainerService.HintSize="720,950" sap2010:WorkflowViewState.IdRef="If_1">
      <If.Then>
        <Sequence DisplayName="Auto Prep" sap:VirtualizedContainerService.HintSize="449.6,650" sap2010:WorkflowViewState.IdRef="Sequence_2">
          <Assign DisplayName="Find latest Email Excel" sap:VirtualizedContainerService.HintSize="416,113.6" sap2010:WorkflowViewState.IdRef="Assign_1">
            <Assign.To>
              <OutArgument x:TypeArguments="x:String">[str_FoundFile]</OutArgument>
            </Assign.To>
            <Assign.Value>
              <InArgument x:TypeArguments="x:String">[Directory.GetFiles(Path.Combine(in_DriveBasePath, "Mail"), "*.xlsx").OrderByDescending(Function(f) New FileInfo(f).LastWriteTime).FirstOrDefault()]</InArgument>
            </Assign.Value>
          </Assign>
          <ui:InvokeCode Code="Dim localPath As String = Path.Combine(Environment.CurrentDirectory, &quot;Data\Input\Emails_Local.xlsx&quot;)&#xA;If File.Exists(localPath) Then&#xA;    File.Delete(localPath)&#xA;End If" DisplayName="Delete Old Email File" sap:VirtualizedContainerService.HintSize="416,113.6" sap2010:WorkflowViewState.IdRef="InvokeCode_DeleteOldEmail" />
          <ui:CopyFile ContinueOnError="{x:Null}" DestinationResource="{x:Null}" PathResource="{x:Null}" Destination="Data\Input\Emails_Local.xlsx" DisplayName="Copy Locally" sap:VirtualizedContainerService.HintSize="416,222.4" sap2010:WorkflowViewState.IdRef="CopyFile_1" Overwrite="True" Path="[str_FoundFile]" />
          <ui:ReadRange Range="{x:Null}" AddHeaders="True" DataTable="[out_dt_Emails]" DisplayName="Read Emails" sap:VirtualizedContainerService.HintSize="416,113.6" sap2010:WorkflowViewState.IdRef="ReadRange_1" SheetName="Sheet1" WorkbookPath="Data\Input\Emails_Local.xlsx" />
        </Sequence>
      </If.Then>
    </If>
    <Assign DisplayName="Format Preview String" sap:VirtualizedContainerService.HintSize="720,113.6" sap2010:WorkflowViewState.IdRef="Assign_Format">
      <Assign.To>
        <OutArgument x:TypeArguments="x:String">[str_CandidatesParam]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:String">[If(in_Mode.Equals("Auto") AndAlso out_dt_Emails IsNot Nothing, String.Join(";", out_dt_Emails.AsEnumerable().Select(Function(r) r(out_dt_Emails.Columns.Cast(Of DataColumn)().FirstOrDefault(Function(c) c.ColumnName.Trim.ToUpper.Contains("CANDIDATE") Or c.ColumnName.Trim.ToUpper.Contains("EMPLOYEE") Or c.ColumnName.Trim.ToUpper.Contains("NAME")).ColumnName).ToString + " &lt;" + r(out_dt_Emails.Columns.Cast(Of DataColumn)().FirstOrDefault(Function(c) c.ColumnName.Trim.ToUpper.Contains("EMAIL")).ColumnName).ToString + "&gt;").ToArray()), in_ManualEmails.Trim)]</InArgument>
      </Assign.Value>
    </Assign>
    <ui:LogMessage DisplayName="Log Review UI" sap:VirtualizedContainerService.HintSize="720,111.2" sap2010:WorkflowViewState.IdRef="LogMessage_Review" Level="Info" Message="[&quot;Step 4: Launching Final Confirmation Screen...&quot;]" />
    <ui:WriteTextFile File="{x:Null}" Output="{x:Null}" FileName="Data\UI\review_data.js" sap:VirtualizedContainerService.HintSize="720,166.4" sap2010:WorkflowViewState.IdRef="WriteTextFile_1" Text="[&quot;var global_mode = '&quot; + in_Mode + &quot;'; var global_jobs = '&quot; + in_JobIds.Replace(&quot;\&quot;, &quot;/&quot;) + &quot;'; var global_template = '&quot; + in_TemplateSelection.Replace(&quot;\&quot;, &quot;/&quot;) + &quot;'; var global_employees = '&quot; + str_CandidatesParam.Replace(&quot;\&quot;, &quot;/&quot;) + &quot;'; var global_pdf_path = '&quot; + Path.Combine(Environment.CurrentDirectory, &quot;Data\Input\Job_Description.pdf&quot;).Replace(&quot;\&quot;, &quot;/&quot;) + &quot;';&quot;]" />
    <ui:CustomInput DisplayName="Final Confirmation Review" Height="700" sap:VirtualizedContainerService.HintSize="720,120" sap2010:WorkflowViewState.IdRef="CustomInput_Review" Result="[out_Confirmed]" TopMost="True" URI="[Path.Combine(Environment.CurrentDirectory, &quot;Data\UI\Review.html&quot;)]" Width="900" />
    <If Condition="[String.IsNullOrEmpty(out_Confirmed) OrElse out_Confirmed.Equals(&quot;No&quot;) OrElse out_Confirmed.Equals(&quot;undefined&quot;)]" DisplayName="Handle Review Cancellation" sap:VirtualizedContainerService.HintSize="720,474.4" sap2010:WorkflowViewState.IdRef="If_Cancel">
      <If.Then>
        <Sequence sap:VirtualizedContainerService.HintSize="449.6,252.4" sap2010:WorkflowViewState.IdRef="Sequence_Cancel">
          <ui:MessageBox Caption="{x:Null}" ChosenButton="{x:Null}" AutoCloseAfter="00:00:00" DisplayName="Abort Message" sap:VirtualizedContainerService.HintSize="416,117.6" sap2010:WorkflowViewState.IdRef="MessageBox_1" Text="[&quot;Dispatch process aborted at review phase.&quot;]" />
          <Assign DisplayName="Set Exit Flag" sap:VirtualizedContainerService.HintSize="416,113.6" sap2010:WorkflowViewState.IdRef="Assign_Exit">
            <Assign.To>
              <OutArgument x:TypeArguments="x:Boolean">[out_UserExit]</OutArgument>
            </Assign.To>
            <Assign.Value>
              <InArgument x:TypeArguments="x:Boolean">True</InArgument>
            </Assign.Value>
          </Assign>
        </Sequence>
      </If.Then>
    </If>
  </Sequence>
</Activity>