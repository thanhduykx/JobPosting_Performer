ullOrWhiteSpace(in_SessionId) Then&#xA;    Try&#xA;        Dim tempDir As String = System.IO.Path.Combine(Environment.CurrentDirectory, &quot;Data\Temp&quot;)&#xA;        If Not System.IO.Directory.Exists(tempDir) Then System.IO.Directory.CreateDirectory(tempDir)&#xA;        Dim sentinelPath As String = System.IO.Path.Combine(tempDir, &quot;close_&quot; + in_SessionId + &quot;.png&quot;)&#xA;        ' 1x1 transparent PNG (68 bytes).&#xA;        Dim pngBytes As Byte() = System.Convert.FromBase64String(&quot;iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNkYPhfDwAChwGA60e6kgAAAABJRU5ErkJggg==&quot;)&#xA;        System.IO.File.WriteAllBytes(sentinelPath, pngBytes)&#xA;        Console.WriteLine(&quot;CloseLoad: wrote sentinel at &quot; + sentinelPath)&#xA;    Catch ex As Exception&#xA;        Console.WriteLine(&quot;CloseLoad: failed to write sentinel: &quot; + ex.Message)&#xA;    End Try&#xA;End If&#xA;&#xA;' Give the HTML ~1.3 seconds to pick up the sentinel and self-close.&#xA;System.Threading.Thread.Sleep(1300)&#xA;&#xA;' --- Fallback #1: try to close the captured launcher process (and its tree).&#xA;If in_Process IsNot Nothing Then&#xA;    Try&#xA;        If Not in_Process.HasExited Then&#xA;            Try&#xA;                in_Process.CloseMainWindow()&#xA;                in_Process.WaitForExit(1000)&#xA;            Catch&#xA;            End Try&#xA;            If Not in_Process.HasExited Then&#xA;                Try&#xA;                    in_Process.Kill(True)&#xA;                Catch&#xA;                    Try : in_Process.Kill() : Catch : End Try&#xA;                End Try&#xA;            End If&#xA;        End If&#xA;    Catch&#xA;    End Try&#xA;End If&#xA;&#xA;' --- Fallback #2: PowerShell helper that kills any msedge.exe whose command&#xA;' line contains session=&lt;id&gt;. Works without window titles.&#xA;If Not String.IsNullOrWhiteSpace(in_SessionId) Then&#xA;    Try&#xA;        Dim scriptPath As String = System.IO.Path.Combine(Environmen