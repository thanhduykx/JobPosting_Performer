    <ui:InvokeCode ContinueOnError="{x:Null}" Code="Dim emailList As New List(Of String)()&#xA;If Not String.IsNullOrWhiteSpace(in_GlobalEmail) Then&#xA;    For Each em As String In in_GlobalEmail.Split(New Char() {&quot;;&quot;c, &quot;,&quot;c}, StringSplitOptions.RemoveEmptyEntries)&#xA;        emailList.Add(&quot;|&quot; + em.Trim())&#xA;    Next&#xA;Else&#xA;    If in_EmailDT IsNot Nothing Then&#xA;        Dim emailCol As String = &quot;&quot;&#xA;        Dim nameCol As String = &quot;&quot;&#xA;        For Each col As System.Data.DataColumn In in_EmailDT.Columns&#xA;            Dim h As String = col.ColumnName.ToUpper()&#xA;            If h.Contains(&quot;EMAIL&quot;) Then emailCol = col.ColumnName&#xA;            If h.Contains(&quot;EMPLOYEE&quot;) OrElse h.Contains(&quot;NAME&quot;) OrElse h.Contains(&quot;CANDIDATE&quot;) Then nameCol = col.ColumnName&#xA;        Next&#xA;        If Not String.IsNullOrEmpty(emailCol) Then&#xA;            For Each r As System.Data.DataRow In in_EmailDT.Rows&#xA;                Dim email As String = If(r(emailCol) IsNot DBNull.Value AndAlso r(emailCol) IsNot Nothing, r(emailCol).ToString().Trim(), &quot;&quot;)&#xA;                Dim name As String = If(Not String.IsNullOrEmpty(nameCol) AndAlso r(nameCol) IsNot DBNull.Value AndAlso r(nameCol) IsNot Nothing, r(nameCol).ToString().Trim(), &quot;&quot;)&#xA;                If Not String.IsNullOrWhiteSpace(email) Then&#xA;                    emailList.Add(name + &quot;|&quot; + email)&#xA;                End If&#xA;            Next&#xA;        End If&#xA;    End If&#xA;End If&#xA;&#xA;Dim posterArr As New Newtonsoft.Json.Linq.JArray()&#xA;If in_Report IsNot Nothing Then&#xA;    For Each row As System.Data.DataRow In in_Report.Rows&#xA;        Dim obj As New Newtonsoft.Json.Linq.JObject()&#xA;        obj(&quot;role&quot;) = Convert.ToString(row(&quot;Role&quot;))&#xA;        Dim fPath As String = Convert.ToString(row(&quot;FilePath&quot;))&#xA;        Dim b64 As String = &quot;&quot;&#xA;        Try&#xA;            If System.IO.File.Exists(fPath) Then&#xA;                b64 = &quot;data:image/png;base64,&quot; + Convert.ToBase64String(System.IO.File.ReadAllBytes(fPath))&#xA;            End If&#xA;        Catch&#xA;        End Try&#xA;        obj(&quot;path&quot;) = b64&#xA;        obj(&quot;success&quot;) = Convert.ToString(row(&quot;Status&quot;)).Equals(&quot;Success&quot;)&#xA;        posterArr.Add(obj)&#xA;    Next&#xA;End If&#xA;&#xA;Dim emailArr As New Newtonsoft.Json.Linq.JArray()&#xA;For Each entry As String In emailList&#xA;    Dim parts = entry.Split(&quot;|&quot;c)&#xA;    Dim obj As New Newtonsoft.Json.Linq.JObject()&#xA;    obj(&quot;name&quot;) = If(parts.Length &gt; 1, parts(0).Trim(), &quot;&quot;)&#xA;    obj(&quot;email&quot;) = parts(parts.Length - 1).Trim()&#xA;    emailArr.Add(obj)&#xA;Next&#xA;&#xA;Dim htmlContent As String = System.IO.File.ReadAllText(in_PreviewFile)&#xA;Dim jsInject As String = &quot;&lt;script&gt;var global_poster_data = &quot; + posterArr.ToString() + &quot;; var global_email_data = &quot; + emailArr.ToString() + &quot;;&lt;/script&gt;&quot;&#xA;htmlContent = htmlContent.Replace(&quot;&lt;/head&gt;&quot;, jsInject + vbCrLf + &quot;&lt;/head&gt;&quot;)&#xA;Dim runFile As String = in_PreviewFile.Replace(&quot;.html&quot;, &quot;_Run.html&quot;)&#xA;System.IO.File.WriteAllText(runFile, htmlContent, System.Text.Encoding.UTF8)&#xA;&#xA;Dim sessionId As String = System.Guid.NewGuid().ToString(&quot;N&quot;)&#xA;Dim edgePath As String = &quot;C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe&quot;&#xA;If Not System.IO.File.Exists(edgePath) Then edgePath = &quot;C:\Program Files\Microsoft\Edge\Application\msedge.exe&quot;&#xA;If Not System.IO.File.Exists(edgePath) Then edgePath = &quot;msedge.exe&quot;&#xA;&#xA;Dim url As String = &quot;file:///&quot; + runFile.Replace(&quot;\&quot;, &quot;/&quot;) + &quot;?session=&quot; + sessionId&#xA;Dim psi As New System.Diagnostics.ProcessStartInfo()&#xA;psi.FileName = edgePath&#xA;psi.Arguments = &quot;--app=&quot;&quot;&quot; + url + &quot;&quot;&quot; --new-window --kiosk&quot;&#xA;psi.UseShellExecute = True&#xA;psi.WindowStyle = System.Diagnostics.ProcessWindowStyle.Maximized&#xA;System.Diagnostics.Process.Start(psi)&#xA;Dim uiTitle As String = &quot;CANVA_PREVIEW::&quot; + sessionId&#xA;Dim uiFile As String = System.IO.Path.GetFileName(runFile)&#xA;Dim prefix As String = &quot;RESULT::&quot; + sessionId + &quot;::&quot;&#xA;Dim result As String = &quot;&quot;&#xA;Dim uiSeen As Boolean = False&#xA;Dim waitForOpenUntil As DateTime = DateTime.Now.AddSeconds(60)&#xA;Dim timeoutAt As DateTime = DateTime.Now.AddHours(8)&#xA;Do While DateTime.Now &lt; timeoutAt AndAlso String.IsNullOrEmpty(result)&#xA;    System.Threading.Thread.Sleep(300)&#xA;    For Each p As System.Diagnostics.Process In System.Diagnostics.Process.GetProcessesByName(&quot;msedge&quot;)&#xA;        Dim title As String = &quot;&quot;&#xA;        Try&#xA;            title = p.MainWindowTitle&#xA;        Catch&#xA;        End Try&#xA;        If String.IsNullOrWhiteSpace(title) Then Continue For&#xA;        If title.Contains(prefix) Then&#xA;            Dim idx As Integer = title.IndexOf(prefix)&#xA;            If idx &gt;= 0 Then&#xA;                result = title.Substring(idx + prefix.Length)&#xA;            End If&#xA;            Try&#xA;                result = System.Uri.UnescapeDataString(result)&#xA;            Catch&#xA;            End Try&#xA;            Try&#xA;                p.CloseMainWindow()&#xA;            Catch&#xA;            End Try&#xA;            Exit For&#xA;        End If&#xA;        If title.Contains(uiTitle) Then&#xA;            uiSeen = True&#xA;        End If&#xA;    Next&#xA;    If String.IsNullOrWhiteSpace(result) AndAlso DateTime.Now &gt; waitForOpenUntil AndAlso (Not uiSeen) Then&#xA;        Throw New Exception(&quot;Timed out opening UI at &quot; + uiTitle + &quot; (&quot; + uiFile + &quot;).&quot;)&#xA;    End If&#xA;Loop&#xA;If String.IsNullOrWhiteSpace(result) Then&#xA;    Throw New Exception(&quot;Timed out waiting for user action at &quot; + uiTitle + &quot; (&quot; + uiFile + &quot;).&quot;)&#xA;End If&#xA;&#xA;out_PreviewResult = result&#xA;out_EmailListStr = String.Join(&quot;;&quot;, emailList)" DisplayName="Build Preview &amp; Wait for Confirmation (extracted)" sap:VirtualizedContainerService.HintSize="449.6,188" sap2010:WorkflowViewState.IdRef="InvokeCode_Preview">
