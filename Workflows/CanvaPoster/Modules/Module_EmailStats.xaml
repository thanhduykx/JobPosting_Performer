  <Sequence sap2010:Annotation.AnnotationText="Goal: Update report row with email send statistics.&#xA;Input: in_Row (DataRow), email counts, sent/failed lists.&#xA;Output: None (modifies in_Row directly).&#xA;Main steps: Build summary string + update row columns." DisplayName="Module_EmailStats" sap:VirtualizedContainerService.HintSize="883.6,1300" sap2010:WorkflowViewState.IdRef="Sequence_1">
    <Sequence.Variables>
      <Variable x:TypeArguments="x:String" Name="strSentSummary" />
    </Sequence.Variables>
    <sap:WorkflowViewStateService.ViewState>
      <scg:Dictionary x:TypeArguments="x:String, x:Object">
        <x:Boolean x:Key="IsExpanded">True</x:Boolean>
      </scg:Dictionary>
    </sap:WorkflowViewStateService.ViewState>
    <If Condition="[in_Total &lt;= 0]" DisplayName="If No Recipients" sap:VirtualizedContainerService.HintSize="450,200" sap2010:WorkflowViewState.IdRef="If_1">
      <If.Then>
        <Assign DisplayName="Set Summary: No Recipients" sap:VirtualizedContainerService.HintSize="350,100" sap2010:WorkflowViewState.IdRef="Assign_NoRecipients">
          <Assign.To>
            <OutArgument x:TypeArguments="x:String">[strSentSummary]</OutArgument>
          </Assign.To>
          <Assign.Value>
            <InArgument x:TypeArguments="x:String">["No recipients"]</InArgument>
          </Assign.Value>
        </Assign>
      </If.Then>
      <If.Else>
        <If Condition="[in_Failed = 0 AndAlso in_Sent &gt; 0]" DisplayName="If All Sent" sap:VirtualizedContainerService.HintSize="350,200" sap2010:WorkflowViewState.IdRef="If_2">
          <If.Then>
            <Assign DisplayName="Set Summary: All Sent" sap:VirtualizedContainerService.HintSize="300,100" sap2010:WorkflowViewState.IdRef="Assign_AllSent">
              <Assign.To>
                <OutArgument x:TypeArguments="x:String">[strSentSummary]</OutArgument>
              </Assign.To>
              <Assign.Value>
                <InArgument x:TypeArguments="x:String">["Sent (" + in_Sent.ToString() + "/" + in_Total.ToString() + ")"]</InArgument>
              </Assign.Value>
            </Assign>
          </If.Then>
          <If.Else>
            <If Condition="[in_Sent &gt; 0]" DisplayName="If Partial Sent" sap:VirtualizedContainerService.HintSize="300,200" sap2010:WorkflowViewState.IdRef="If_3">
              <If.Then>
                <Assign DisplayName="Set Summary: Partial" sap:VirtualizedContainerService.HintSize="280,100" sap2010:WorkflowViewState.IdRef="Assign_Partial">
                  <Assign.To>
                    <OutArgument x:TypeArguments="x:String">[strSentSummary]</OutArgument>
                  </Assign.To>
                  <Assign.Value>
                    <InArgument x:TypeArguments="x:String">["Partial (" + in_Sent.ToString() + "/" + in_Total.ToString() + ")"]</InArgument>
                  </Assign.Value>
                </Assign>
              </If.Then>
              <If.Else>
                <Assign DisplayName="Set Summary: All Failed" sap:VirtualizedContainerService.HintSize="280,100" sap2010:WorkflowViewState.IdRef="Assign_AllFailed">
                  <Assign.To>
                    <OutArgument x:TypeArguments="x:String">[strSentSummary]</OutArgument>
                  </Assign.To>
                  <Assign.Value>
                    <InArgument x:TypeArguments="x:String">["Failed (0/" + in_Total.ToString() + ")"]</InArgument>
                  </Assign.Value>
                </Assign>
              </If.Else>
            </If>
          </If.Else>
        </If>
      </If.Else>
    </If>
    <Assign DisplayName="Update Row: AttachmentSentPath" sap:VirtualizedContainerService.HintSize="450,100" sap2010:WorkflowViewState.IdRef="Assign_AttachmentPath">
