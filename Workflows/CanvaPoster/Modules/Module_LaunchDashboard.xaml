    <ui:InvokeCode ContinueOnError="{x:Null}" Code="Dim templatesList As New List(Of String)()&#xA;Dim apiError As String = &quot;&quot;&#xA;Try&#xA;    If in_StatusCode &gt;= 200 AndAlso in_StatusCode &lt; 300 AndAlso Not String.IsNullOrWhiteSpace(in_Response) Then&#xA;        Dim root = Newtonsoft.Json.Linq.JObject.Parse(in_Response)&#xA;        Dim items = root(&quot;items&quot;)&#xA;        If items IsNot Nothing Then&#xA;            For Each item In items&#xA;                Dim id As String = If(item(&quot;id&quot;) IsNot Nothing, item(&quot;id&quot;).ToString(), &quot;&quot;)&#xA;                Dim title As String = If(item(&quot;title&quot;) IsNot Nothing, item(&quot;title&quot;).ToString(), &quot;Untitled&quot;)&#xA;                Dim folderName As String = &quot;&quot;&#xA;                Try&#xA;                    If item(&quot;folder&quot;) IsNot Nothing AndAlso item(&quot;folder&quot;)(&quot;name&quot;) IsNot Nothing Then&#xA;                        folderName = item(&quot;folder&quot;)(&quot;name&quot;).ToString()&#xA;                    ElseIf item(&quot;folder_name&quot;) IsNot Nothing Then&#xA;                        folderName = item(&quot;folder_name&quot;).ToString()&#xA;                    End If&#xA;                Catch&#xA;                End Try&#xA;&#xA;                Dim sourceTag As String = (folderName + &quot; &quot; + title).ToUpperInvariant()&#xA;                Dim groupTag As String = &quot;&quot;&#xA;                If sourceTag.StartsWith(&quot;G_&quot;) OrElse sourceTag.StartsWith(&quot;GROUP_&quot;) OrElse sourceTag.Contains(&quot;GROUP_TEMPLATE&quot;) OrElse sourceTag.Contains(&quot;GROUP&quot;) Then&#xA;                    groupTag = &quot;GROUP&quot;&#xA;                ElseIf sourceTag.StartsWith(&quot;I_&quot;) OrElse sourceTag.StartsWith(&quot;INDIVIDUAL_&quot;) OrElse sourceTag.StartsWith(&quot;INVIDUAL_&quot;) OrElse sourceTag.Contains(&quot;INVIDUAL_TEMPLATE&quot;) OrElse sourceTag.Contains(&quot;INDIVIDUAL_TEMPLATE&quot;) OrElse sourceTag.Contains(&quot;INDIVIDUAL&quot;) OrElse sourceTag.Contains(&quot;SINGLE&quot;) Then&#xA;                    groupTag = &quot;INDIVIDUAL&quot;&#xA;                End If&#xA;&#xA;                If Not String.IsNullOrEmpty(id) Then&#xA;                    templatesList.Add(id + &quot;|&quot; + System.Uri.EscapeDataString(title) + &quot;|&quot; + groupTag)&#xA;                End If&#xA;&#xA;                If templatesList.Count &gt;= 500 Then Exit For&#xA;            Next&#xA;        End If&#xA;    Else&#xA;        apiError = &quot;Canva API error &quot; + in_StatusCode.ToString() + &quot; (GET /brand-templates). &quot; + If(String.IsNullOrWhiteSpace(in_Response), &quot;&lt;empty response&gt;&quot;, in_Response)&#xA;    End If&#xA;Catch ex As Exception&#xA;    apiError = &quot;Canva API parse failed: &quot; + ex.Message&#xA;End Try&#xA;&#xA;If Not String.IsNullOrWhiteSpace(apiError) Then&#xA;    Console.WriteLine(&quot;[CANVA API ERROR] &quot; + apiError)&#xA;    Try&#xA;        Dim popupMsg As String = &quot;Canva API Error:&quot; + vbCrLf + vbCrLf + apiError + vbCrLf + vbCrLf + _&#xA;            &quot;Dashboard will still open, but the template list may be empty / incomplete.&quot; + vbCrLf + _&#xA;            &quot;Please check your Canva token / network and retry.&quot;&#xA;        Dim thMb As New System.Threading.Thread(Sub()&#xA;            Try&#xA;                Microsoft.VisualBasic.Interaction.MsgBox(popupMsg, MsgBoxStyle.Exclamation Or MsgBoxStyle.OkOnly, &quot;Canva Poster - API Error&quot;)&#xA;            Catch&#xA;            End Try&#xA;        End Sub)&#xA;        thMb.SetApartmentState(System.Threading.ApartmentState.STA)&#xA;        thMb.Start()&#xA;        thMb.Join(15000)&#xA;    Catch&#xA;    End Try&#xA;End If&#xA;&#xA;Dim global_templates = String.Join(&quot;;&quot;, templatesList)&#xA;Dim jobsList As New List(Of String)()&#xA;jobsList.Add(&quot;ALL&quot;)&#xA;If in_Jobs IsNot Nothing Then&#xA;    For Each row As System.Data.DataRow In in_Jobs.Rows&#xA;        If in_Jobs.Columns.Contains(&quot;Role&quot;) Then&#xA;            jobsList.Add(row(&quot;Role&quot;).ToString().Trim())&#xA;        End If&#xA;    Next&#xA;End If&#xA;Dim global_jobs = String.Join(&quot;;&quot;, jobsList)&#xA;&#xA;' Write sidecar data file loaded by CanvaDashboard.html&#xA;Dim uiDir As String = System.IO.Path.GetDirectoryName(in_File)&#xA;Dim dataFile As String = System.IO.Path.Combine(uiDir, &quot;canvadashboard_data.js&quot;)&#xA;Dim dataJs As String = &quot;// Auto-generated at runtime. Do not edit.&quot; + vbCrLf&#xA;dataJs += &quot;var global_jobs = &quot; + Newtonsoft.Json.JsonConvert.SerializeObject(global_jobs) + &quot;;&quot; + vbCrLf&#xA;dataJs += &quot;var global_templates = &quot; + Newtonsoft.Json.JsonConvert.SerializeObject(global_templates) + &quot;;&quot; + vbCrLf&#xA;System.IO.File.WriteAllText(dataFile, dataJs, New System.Text.UTF8Encoding(False))&#xA;&#xA;Dim sessionId As String = System.Guid.NewGuid().ToString(&quot;N&quot;)&#xA;Dim edgePath As String = &quot;C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe&quot;&#xA;If Not System.IO.File.Exists(edgePath) Then edgePath = &quot;C:\Program Files\Microsoft\Edge\Application\msedge.exe&quot;&#xA;If Not System.IO.File.Exists(edgePath) Then edgePath = &quot;msedge.exe&quot;&#xA;&#xA;Dim url As String = &quot;file:///&quot; + in_File.Replace(&quot;\&quot;, &quot;/&quot;) + &quot;?session=&quot; + sessionId&#xA;Dim psi As New System.Diagnostics.ProcessStartInfo()&#xA;psi.FileName = edgePath&#xA;psi.Arguments = &quot;--app=&quot;&quot;&quot; + url + &quot;&quot;&quot; --new-window --kiosk --disable-features=msSmartScreenProtection&quot;&#xA;psi.UseShellExecute = True&#xA;psi.WindowStyle = System.Diagnostics.ProcessWindowStyle.Maximized&#xA;System.Diagnostics.Process.Start(psi)&#xA;&#xA;Dim uiTitle As String = &quot;CANVA_DASHBOARD::&quot; + sessionId&#xA;Dim uiFile As String = System.IO.Path.GetFileName(in_File)&#xA;Dim prefix As String = &quot;RESULT::&quot; + sessionId + &quot;::&quot;&#xA;Dim clipPrefix As String = &quot;CANVA_RESULT::&quot; + sessionId + &quot;::&quot;&#xA;Dim result As String = &quot;&quot;&#xA;Dim timeoutAt As DateTime = DateTime.Now.AddHours(8)&#xA;&#xA;Do While DateTime.Now &lt; timeoutAt AndAlso String.IsNullOrEmpty(result)&#xA;    System.Threading.Thread.Sleep(300)&#xA;&#xA;    Dim seenResult As Boolean = False&#xA;    Dim targetProc As System.Diagnostics.Process = Nothing&#xA;&#xA;    For Each p As System.Diagnostics.Process In System.Diagnostics.Process.GetProcessesByName(&quot;msedge&quot;)&#xA;        Dim t As String = &quot;&quot;&#xA;        Try&#xA;            t = p.MainWindowTitle&#xA;        Catch&#xA;            Continue For&#xA;        End Try&#xA;        If String.IsNullOrWhiteSpace(t) Then Continue For&#xA;&#xA;        If t.Contains(prefix) Then&#xA;            Dim idxR As Integer = t.IndexOf(prefix)&#xA;            If idxR &gt;= 0 Then&#xA;                result = t.Substring(idxR + prefix.Length)&#xA;            End If&#xA;            Try&#xA;                result = System.Uri.UnescapeDataString(result)&#xA;            Catch&#xA;            End Try&#xA;            seenResult = True&#xA;            targetProc = p&#xA;            Exit For&#xA;        End If&#xA;    Next&#xA;&#xA;    If Not seenResult Then&#xA;        Dim clipText As String = &quot;&quot;&#xA;        Try&#xA;            Dim thClip As New System.Threading.Thread(Sub()&#xA;                Try&#xA;                    If System.Windows.Clipboard.ContainsText() Then&#xA;                        clipText = System.Windows.Clipboard.GetText()&#xA;                    End If&#xA;                Catch&#xA;                End Try&#xA;            End Sub)&#xA;            thClip.SetApartmentState(System.Threading.ApartmentState.STA)&#xA;            thClip.Start()&#xA;            thClip.Join(1500)&#xA;        Catch&#xA;        End Try&#xA;&#xA;        If Not String.IsNullOrWhiteSpace(clipText) AndAlso clipText.Contains(clipPrefix) Then&#xA;            Dim idxC As Integer = clipText.IndexOf(clipPrefix)&#xA;            If idxC &gt;= 0 Then&#xA;                Dim payload As String = clipText.Substring(idxC + clipPrefix.Length)&#xA;                Try&#xA;                    result = System.Uri.UnescapeDataString(payload)&#xA;                Catch&#xA;                    result = payload&#xA;                End Try&#xA;                seenResult = True&#xA;                Try&#xA;                    Dim thClr As New System.Threading.Thread(Sub()&#xA;                        Try&#xA;                            System.Windows.Clipboard.Clear()&#xA;                        Catch&#xA;                        End Try&#xA;                    End Sub)&#xA;                    thClr.SetApartmentState(System.Threading.ApartmentState.STA)&#xA;                    thClr.Start()&#xA;                    thClr.Join(1500)&#xA;                Catch&#xA;                End Try&#xA;            End If&#xA;        End If&#xA;    End If&#xA;&#xA;    If seenResult Then&#xA;        Try&#xA;            If targetProc IsNot Nothing Then targetProc.CloseMainWindow()&#xA;        Catch&#xA;        End Try&#xA;        Try&#xA;            For Each p As System.Diagnostics.Process In System.Diagnostics.Process.GetProcessesByName(&quot;msedge&quot;)&#xA;                Try&#xA;                    Dim mt As String = p.MainWindowTitle&#xA;                    If Not String.IsNullOrWhiteSpace(mt) AndAlso (mt.Contains(prefix) OrElse mt.Contains(uiTitle)) Then&#xA;                        p.CloseMainWindow()&#xA;                    End If&#xA;                Catch&#xA;                End Try&#xA;            Next&#xA;        Catch&#xA;        End Try&#xA;        Exit Do&#xA;    End If&#xA;Loop&#xA;&#xA;If String.IsNullOrWhiteSpace(result) Then&#xA;    Throw New Exception(&quot;Timed out waiting for user action at &quot; + uiTitle + &quot; (&quot; + uiFile + &quot;).&quot;)&#xA;End If&#xA;&#xA;If result.Trim().ToUpperInvariant() = &quot;CANCEL&quot; Then&#xA;    Throw New Exception(&quot;User cancelled at &quot; + uiTitle + &quot; (&quot; + uiFile + &quot;). Workflow stopped.&quot;)&#xA;End If&#xA;&#xA;Console.WriteLine(&quot;UI Result Received: &quot; + result)&#xA;out_Result = result" DisplayName="Launch Canva Dashboard (extracted)" sap:VirtualizedContainerService.HintSize="449.6,188" sap2010:WorkflowViewState.IdRef="InvokeCode_Dashboard">
