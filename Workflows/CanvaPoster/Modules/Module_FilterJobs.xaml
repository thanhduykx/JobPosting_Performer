            <InOutArgument x:TypeArguments="sd:DataTable" x:Key="io_Jobs">[io_Jobs]</InOutArgument>
          </ui:InvokeCode.Arguments>
        </ui:InvokeCode>
      </If.Then>
    </If>
    <ui:LogMessage DisplayName="Log Filter Result" sap:VirtualizedContainerService.HintSize="450,80" sap2010:WorkflowViewState.IdRef="LogMessage_1" Level="Info" Message="[&quot;FilterJobs: Processed &quot; + If(io_Jobs IsNot Nothing, io_Jobs.Rows.Count.ToString(), &quot;0&quot;) + &quot; job rows (GroupMode=&quot; + bolIsGroupMode.ToString() + &quot;)&quot;]" />
