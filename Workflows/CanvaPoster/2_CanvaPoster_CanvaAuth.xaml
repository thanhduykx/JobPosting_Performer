 String = Convert.ToBase64String(authBytes)&#xA;    client.DefaultRequestHeaders.Add(&quot;Authorization&quot;, &quot;Basic &quot; + authBase64)&#xA;End If&#xA;&#xA;Dim postBody As New System.Net.Http.FormUrlEncodedContent(postParams)&#xA;Dim response As System.Net.Http.HttpResponseMessage = client.PostAsync(&quot;https://api.canva.com/rest/v1/oauth/token&quot;, postBody).Result&#xA;Dim body As String = response.Content.ReadAsStringAsync().Result&#xA;&#xA;If Not response.IsSuccessStatusCode Then&#xA;    If CInt(response.StatusCode) = 400 AndAlso body.ToLowerInvariant().Contains(&quot;invalid_grant&quot;) Then&#xA;        Dim scriptPath As String = System.IO.Path.Combine(Environment.CurrentDirectory, &quot;Scripts\canva_reauth.ps1&quot;)&#xA;        If Not System.IO.File.Exists(scriptPath) Then Throw New Exception(&quot;Refresh token revoked and reauth script not found: &quot; + scriptPath)&#xA;        Dim psi As New System.Diagnostics.ProcessStartInfo()&#xA;        psi.FileName = &quot;powershell.exe&quot;&#xA;        psi.Arguments = &quot;-ExecutionPolicy Bypass -File &quot;&quot;&quot; + scriptPath + &quot;&quot;&quot;&quot;&#xA;        psi.UseShellExecute = True&#xA;        Dim p As System.Diagnostics.Process = System.Diagnostics.Process.Start(psi)&#xA;        p.WaitForExit()&#xA;        Dim newJson As String = System.IO.File.ReadAllText(tokenFilePath)&#xA;        Dim newObj As Newtonsoft.Json.Linq.JObject = Newtonsoft.Json.Linq.JObject.Parse(newJson)&#xA;        Dim freshAccess As String = If(newObj(&quot;access_token&quot;) IsNot Nothing, newObj(&quot;access_token&quot;).ToString(), String.Empty)&#xA;        If String.IsNullOrWhiteSpace(freshAccess) Then Throw New Exception(&quot;Re-auth completed but access_token is missing in token file.&quot;)&#xA;        out_NewToken = freshAccess&#xA;    Else&#xA;        Throw New Exception(&quot;Refresh failed [&quot; + CInt(response.StatusCode).ToString() + &quot;]: &quot; + body)&#xA;    End If&#xA;Else&#xA;    Dim respObj As Newtonsoft.Json.Linq.JObject = Newtonsoft.Json.Linq.JObject.Parse(body)&#xA;    Dim newToken As New Newtonsoft.Json.Linq.JObject()&#xA;    newToken(&quot;access_token&quot;) = respObj(&quot;access_token&quot;).ToString()&#xA;    newToken(&quot;token_type&quot;) = &quot;Bearer&quot;&#xA;    newToken(&quot;created_at&quot;) = DateTime.Now.ToString(&quot;yyyy-MM-dd HH:mm:ss&quot;)&#xA;    newToken(&quot;expires_in&quot;) = respObj(&quot;expires_in&quot;).ToString()&#xA;    If respObj(&quot;refresh_token&quot;) IsNot Nothing AndAlso Not String.IsNullOrWhiteSpace(respObj(&quot;refresh_token&quot;).ToString()) Then&#xA;        newToken(&quot;refresh_token&quot;) = respObj(&quot;refresh_token&quot;).ToString()&#xA;    Else&#xA;        newToken(&quot;refresh_token&quot;) = refreshToken&#xA;    End If&#xA;    newToken(&quot;expires_at&quot;) = DateTime.Now.AddSeconds(CDbl(respObj(&quot;expires_in&quot;).ToString())).ToString(&quot;yyyy-MM-dd HH:mm:ss&quot;)&#xA;    System.IO.File.WriteAllText(tokenFilePath, newToken.ToString(), System.Text.Encoding.UTF8)&#xA;    out_NewToken = respObj(&quot;access_token&quot;).ToString()&#xA;End If" DisplayName="Refresh Token via OAuth" sap:VirtualizedContainerService.HintSize="415.2,196.8" sap2010:WorkflowViewState.IdRef="InvokeCode_Refresh">
